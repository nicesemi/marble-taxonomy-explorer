---
import GraphExplorer from '../components/GraphExplorer.svelte';
import { buildGraphData } from '../lib/graph-data';
import '../styles/global.css';

const graphData = buildGraphData();
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <title>关系图浏览器 — 知识分类浏览器</title>
    <meta name="description" content="Marble 技能分类体系交互式关系图 — 探索 1,590 个微主题之间的前置依赖关系。" />
    <meta property="og:title" content="关系图浏览器 — 知识分类浏览器" />
    <meta property="og:description" content="交互式关系图 — 探索 1,590 个微主题之间的前置依赖关系。支持邻域视图和全局图模式。" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${base}og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="关系图浏览器 — 知识分类浏览器" />
    <meta name="twitter:description" content="交互式关系图 — 探索 1,590 个微主题之间的前置依赖关系。支持邻域视图和全局图模式。" />
    <meta name="twitter:image" content={`${base}og-image.png`} />
  </head>
  <body style="overflow: hidden; height: 100vh; margin: 0; display: flex; flex-direction: column;">
    <div style="flex: 1;">
      <GraphExplorer
        client:load
        nodes={graphData.nodes}
        edges={graphData.edges}
      />
    </div>
    <footer style="text-align: center; padding: 4px 0; font-size: 10px; color: #9ca3af; background: #fff; border-top: 1px solid #e5e7eb;">
      数据：<a href="https://github.com/withmarbleapp/os-taxonomy" style="color: #6366f1;">Marble 技能分类体系 (v1)</a>
      &copy; <a href="https://withmarble.com" style="color: #6366f1;">Generative Spark, Inc. (Marble)</a>
      &mdash; ODbL 1.0 / CC BY-SA 4.0。
      社区工具 &mdash; 与 Marble 无关。
    </footer>
  </body>
</html>
